# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Origenes permitidos para CORS (separados por coma), o * para todos
CORS_ORIGINS=*
# Zona horaria por defecto para profesionales nuevos
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
# Nivel de log de pino: trace|debug|info|warn|error|fatal
LOG_LEVEL=debug

# ============================================================
# PostgreSQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=turnerito
DB_PASSWORD=turnerito
DB_NAME=turnerito
# true en produccion si el server exige SSL (Coolify/managed)
DB_SSL=false
# No usar synchronize nunca: las migraciones manejan el esquema
DB_LOGGING=false

# ============================================================
# Redis (BullMQ + cache + websocket adapter)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=cambiame_access_secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=cambiame_refresh_secret
JWT_REFRESH_TTL=30d

# ============================================================
# Google OAuth
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ============================================================
# MercadoPago
# ============================================================
# Access token de la PLATAFORMA (cobra las suscripciones). Vacio = modo stub.
MERCADOPAGO_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# App de MP para el OAuth de los profesionales (marketplace).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# A donde vuelve MP tras autorizar la conexion del profesional (debe coincidir
# con la "redirect URI" cargada en el panel de MP).
MP_OAUTH_REDIRECT_URI=http://localhost:3000/payments/mp/oauth/callback
# Comision de la plataforma sobre señas/turnos (0 = el profesional cobra todo).
MP_MARKETPLACE_FEE_PERCENT=0
# URL del front a la que se redirige tras volver del checkout / OAuth.
MP_FRONT_RETURN_URL=http://localhost:5173

# ============================================================
# Suscripcion (prueba / gracia / precio)
# ============================================================
# Dias de prueba gratis al auto-registrarse el profesional.
SUBSCRIPTION_TRIAL_DAYS=15
# Dias de gracia tras vencer antes de bloquear la escritura.
SUBSCRIPTION_GRACE_DAYS=3
# Precio mensual de la suscripcion (centavos).
SUBSCRIPTION_PRICE_CENTS=1100000

# ============================================================
# MinIO / S3
# ============================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=turnerito

# ============================================================
# Notificaciones (stub por ahora)
# ============================================================
MAIL_FROM=no-reply@turnerito.app
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ============================================================
# Rate limiting
# ============================================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ============================================================
# Archivos (subida): limites de tamaño y compresion de imagenes
# ============================================================
# Tope de entrada para imagenes (MB); se comprimen a webp antes de guardar.
FILE_MAX_IMAGE_MB=10
# Tope para PDFs (MB); no se comprimen, se rechazan si superan.
FILE_MAX_PDF_MB=3
# Ancho maximo al redimensionar imagenes.
FILE_IMAGE_MAX_WIDTH=2000
# Calidad webp inicial (se baja por pasos si no entra en el target).
FILE_IMAGE_WEBP_QUALITY=85
# Peso objetivo de la imagen comprimida (KB).
FILE_IMAGE_TARGET_KB=1536
